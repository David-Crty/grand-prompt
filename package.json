{
  "name": "f1-llm-bench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/viewer --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "bench": "tsx packages/cli/src/main.ts",
    "build-drivers": "tsx scripts/build-drivers/main.tsx",
    "determinism": "tsx scripts/determinism-check.ts",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@bench/reference-driver": "workspace:*",
    "@bench/sandbox": "workspace:*",
    "@bench/sim": "workspace:*",
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "ink": "8.0.0",
    "meshoptimizer": "1.1.1",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
